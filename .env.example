GEMINI_API_KEY=your-gemini-api-key-here

# Optional: pick a specific microphone by index (see list_audio_devices.py).
# Leave unset to use the OS default input device.
INPUT_DEVICE_INDEX=

# Optional: pick a specific speaker/output device by index (see list_audio_devices.py).
# If your mic is a Bluetooth headset, point this at a DIFFERENT device (e.g. your
# laptop's built-in speakers) -- using the same Bluetooth device for both mic input
# and speaker output forces Windows into the low-bandwidth HFP profile, which breaks
# after the first exchange. Leave unset to use the OS default output device.
OUTPUT_DEVICE_INDEX=
